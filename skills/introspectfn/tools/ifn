#!/usr/bin/env bash
# ifn — IntrospectFN CLI
# Modular CLI for ERP analysis and bookkeeping operations.
#
# Usage: ifn <command> [subcommand] [options]
#
# Environment:
#   IFN_BASE_URL   API base URL (default: http://localhost:8000)
#   IFN_API_KEY    API key for authentication (Bearer token)
#   IFN_CONFIG     Path to config file (default: ~/.ifn/config)

set -euo pipefail

# Resolve script directory (works with symlinks)
IFN_ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
IFN_CLI_DIR="${IFN_ROOT}/ifn-cli"

# Source core libraries
# shellcheck source=ifn-cli/config.sh
source "${IFN_CLI_DIR}/config.sh"
# shellcheck source=ifn-cli/lib/http.sh
source "${IFN_CLI_DIR}/lib/http.sh"
# shellcheck source=ifn-cli/lib/format.sh
source "${IFN_CLI_DIR}/lib/format.sh"
# shellcheck source=ifn-cli/lib/auth.sh
source "${IFN_CLI_DIR}/lib/auth.sh"
# shellcheck source=ifn-cli/lib/deeplink.sh
source "${IFN_CLI_DIR}/lib/deeplink.sh"

# --- Subcommand dispatch ---

ifn_usage() {
    cat <<'USAGE'
ifn — IntrospectFN CLI

Usage: ifn <command> [subcommand] [options]

Commands:
  health                          Check API connectivity
  companies  list                 List connected ERP companies
  dashboard  <company_id>         Dashboard metrics for a company
  browse     <company_id> <resource> [id]  Browse live ERP records
  records    <company_id> <doc_type> [id]  Browse synced local records
  files      list|fetch|refresh|categories|...  File management
  analysis   accounts|balances|integrity|series  Financial analysis
  sync       status|overview|years|trigger|cancel  Sync management
  staging    list|list-all|get|propose|write-windows  Staging workflow
  auth       login|status|rotate               Authentication and key management
  link       <type> <company_id> [args]         Generate web app deep links
  bk         find|parse|propose|mapping|...  Bookkeeping operations (settlements, adjustments)
  version                         Show CLI version

Options:
  --help, -h     Show this help
  --json         Raw JSON output (no formatting)
  --verbose, -v  Verbose output
  --insecure     Skip SSL certificate validation

Environment:
  IFN_BASE_URL   API base URL (required — set via skill credentials)
  IFN_API_KEY    API key (Bearer token, set by skill credential system)
  IFN_INSECURE   Skip SSL cert validation (default: true)
  IFN_WEB_URL    Web app URL for deep links (default: IFN_BASE_URL)

Getting started:
  ifn auth login                   # Authenticate (first time setup)
  ifn health                       # Verify connectivity
  ifn companies list               # List connected companies
USAGE
}

ifn_version() {
    echo "ifn 0.2.6 (IntrospectFN CLI)"
}

# Parse global flags
IFN_RAW_JSON="${IFN_RAW_JSON:-false}"
IFN_VERBOSE="${IFN_VERBOSE:-false}"

ARGS=()
for arg in "$@"; do
    case "$arg" in
        --json) IFN_RAW_JSON=true ;;
        --verbose|-v) IFN_VERBOSE=true ;;
        --insecure) IFN_INSECURE=true ;;
        --help|-h)
            if [ ${#ARGS[@]} -eq 0 ]; then
                ifn_usage
                exit 0
            fi
            ARGS+=("$arg")
            ;;
        *) ARGS+=("$arg") ;;
    esac
done
export IFN_RAW_JSON IFN_VERBOSE IFN_INSECURE

set -- "${ARGS[@]+"${ARGS[@]}"}"

if [ $# -eq 0 ]; then
    ifn_usage
    exit 1
fi

COMMAND="$1"
shift

# Load config — soft mode for commands that can work without it
case "$COMMAND" in
    version|--version)
        ifn_version
        exit 0
        ;;
    auth)
        if [ "${1:-}" = "login" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
            ifn_load_config 2>/dev/null || true
        else
            ifn_load_config
        fi
        ;;
    *)
        ifn_load_config
        ;;
esac

# Source and dispatch command
case "$COMMAND" in
    health)
        source "${IFN_CLI_DIR}/commands/health.sh"
        cmd_health "$@"
        ;;
    companies)
        source "${IFN_CLI_DIR}/commands/companies.sh"
        cmd_companies "$@"
        ;;
    dashboard)
        source "${IFN_CLI_DIR}/commands/dashboard.sh"
        cmd_dashboard "$@"
        ;;
    browse)
        source "${IFN_CLI_DIR}/commands/browse.sh"
        cmd_browse "$@"
        ;;
    records)
        source "${IFN_CLI_DIR}/commands/records.sh"
        cmd_records "$@"
        ;;
    analysis)
        source "${IFN_CLI_DIR}/commands/analysis.sh"
        cmd_analysis "$@"
        ;;
    sync)
        source "${IFN_CLI_DIR}/commands/sync.sh"
        cmd_sync "$@"
        ;;
    staging)
        source "${IFN_CLI_DIR}/commands/staging.sh"
        cmd_staging "$@"
        ;;
    auth)
        source "${IFN_CLI_DIR}/commands/auth.sh"
        cmd_auth "$@"
        ;;
    link)
        source "${IFN_CLI_DIR}/commands/link.sh"
        cmd_link "$@"
        ;;
    files)
        source "${IFN_CLI_DIR}/commands/files.sh"
        cmd_files "$@"
        ;;
    xcompanies)
        source "${IFN_CLI_DIR}/commands/xcompanies.sh"
        cmd_xcompanies "$@"
        ;;
    jobs)
        source "${IFN_CLI_DIR}/commands/jobs.sh"
        cmd_jobs "$@"
        ;;
    bk)
        source "${IFN_CLI_DIR}/commands/bk.sh"
        cmd_bk "$@"
        ;;
    *)
        echo "Error: unknown command '$COMMAND'" >&2
        echo "Run 'ifn --help' for usage." >&2
        exit 1
        ;;
esac
